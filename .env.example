# 复制本文件为 .env，再把下面的值改成你自己的 DashScope API Key
# Key 申请地址：https://dashscope.console.aliyun.com/
DASHSCOPE_API_KEY=sk-在这里填入你的密钥

# ===== 以下为可选配置（不设则用代码内置默认值，取消注释即可覆盖） =====
# 大模型名称：qwen-plus / qwen-max / qwen-flash
# RAG_LLM_MODEL=qwen-plus
# 重排序模型
# RAG_RERANK_MODEL=gte-rerank-v2
# 分块大小与重叠
# RAG_CHUNK_SIZE=500
# RAG_CHUNK_OVERLAP=50
# 语义相似度阈值（0-1，低于此值的段落被过滤；仅 embedding 降级路径使用）
# RAG_SIMILARITY_THRESHOLD=0.4
# 参与查询改写的历史轮数
# RAG_MAX_HISTORY_ROUND=2
